{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.yoto-ai/playlist-package-v1.schema.json",
  "title": "Yoto Playlist Package v1",
  "type": "object",
  "required": ["schemaVersion", "title", "source", "cover", "tracks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 140 },
    "source": {
      "type": "object",
      "required": ["type", "id", "description", "permission"],
      "properties": {
        "type": { "enum": ["spotdl", "drive", "local"] },
        "id": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "description": { "type": "string", "minLength": 1 },
        "permission": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "cover": { "$ref": "#/$defs/file" },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["position", "sourceId", "title", "artist", "audio"],
        "properties": {
          "position": { "type": "integer", "minimum": 1 },
          "sourceId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "artist": { "type": "string" },
          "audio": {
            "allOf": [
              { "$ref": "#/$defs/file" },
              {
                "type": "object",
                "required": ["duration", "format"],
                "properties": {
                  "duration": { "type": "number", "minimum": 0 },
                  "format": { "enum": ["mp3", "m4a", "aac", "wav", "flac", "ogg", "opus"] }
                }
              }
            ]
          },
          "icon": { "$ref": "#/$defs/file" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
